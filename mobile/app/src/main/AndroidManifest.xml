<?xml version="1.0" encoding="utf-8"?>
<!--
    AndroidManifest.xml – Declaração de todas as Activities e permissões.
    
    Decisão: Cada ecrã é uma Activity separada (requisito do enunciado).
    Usamos INTERNET permission para comunicar com a API FastAPI.
    
    A LoginActivity é o ponto de entrada (launcher).
    Após login bem-sucedido, navega para MainActivity (dashboard).
-->
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <!-- Permissão de Internet para chamadas à API REST -->
    <uses-permission android:name="android.permission.INTERNET" />
    <!-- Permissão para verificar estado da rede -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <!-- Permissão para ler imagens da galeria (bonus) -->
    <uses-permission android:name="android.permission.READ_MEDIA_IMAGES" />
    <!-- Fallback para Android < 13 -->
    <uses-permission android:name="android.permission.READ_EXTERNAL_STORAGE"
        android:maxSdkVersion="32" />

    <application
        android:allowBackup="true"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.ATECGestao"
        android:usesCleartextTraffic="true"
        tools:targetApi="31">

        <!-- 
            LoginActivity: Ecrã de entrada da aplicação.
            É a launcher activity (primeira a abrir). 
        -->
        <activity
            android:name=".ui.LoginActivity"
            android:exported="true"
            android:screenOrientation="portrait">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!--
            MainActivity: Dashboard principal com 4 cards de navegação.
            Acessível apenas após autenticação.
        -->
        <activity
            android:name=".ui.MainActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- CoursesActivity: Lista de cursos com pesquisa e filtros -->
        <activity
            android:name=".ui.CoursesActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- CourseDetailActivity: Detalhes de um curso e seus módulos -->
        <activity
            android:name=".ui.CourseDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- StudentsActivity: Lista de formandos com pesquisa -->
        <activity
            android:name=".ui.StudentsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- StudentDetailActivity: Perfil de um formando -->
        <activity
            android:name=".ui.StudentDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- TrainersActivity: Lista de formadores com pesquisa -->
        <activity
            android:name=".ui.TrainersActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- TrainerDetailActivity: Perfil e horário do formador -->
        <activity
            android:name=".ui.TrainerDetailActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ClassroomsActivity: Lista de salas -->
        <activity
            android:name=".ui.ClassroomsActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ClassroomScheduleActivity: Ocupação de uma sala por data -->
        <activity
            android:name=".ui.ClassroomScheduleActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

        <!-- ProfileActivity: Perfil do utilizador com foto da galeria (bonus) -->
        <activity
            android:name=".ui.ProfileActivity"
            android:exported="false"
            android:screenOrientation="portrait" />

    </application>
</manifest>
