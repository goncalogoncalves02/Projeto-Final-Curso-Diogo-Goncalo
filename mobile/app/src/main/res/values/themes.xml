<?xml version="1.0" encoding="utf-8"?>
<!--
    Tema moderno da aplicação baseado em Material 3.
    Status bar com cor primária escura para visual consistente.
-->
<resources>
    <style name="Theme.ATECGestao" parent="Theme.Material3.DayNight.NoActionBar">
        <!-- Cores primárias -->
        <item name="colorPrimary">@color/primary</item>
        <item name="colorPrimaryDark">@color/primary_dark</item>
        <item name="colorOnPrimary">@color/on_primary</item>

        <!-- Cores secundárias -->
        <item name="colorSecondary">@color/secondary</item>
        <item name="colorOnSecondary">@color/on_secondary</item>

        <!-- Cores de fundo e superfície -->
        <item name="android:colorBackground">@color/background</item>
        <item name="colorSurface">@color/surface</item>
        <item name="colorOnSurface">@color/on_surface</item>

        <!-- Cor de erro -->
        <item name="colorError">@color/error</item>

        <!-- Status bar -->
        <item name="android:statusBarColor">@color/primary_dark</item>

        <!-- Estilo de botões customizado -->
        <item name="materialButtonStyle">@style/Widget.ATECGestao.Button</item>

        <!-- Cards melhorados -->
        <item name="materialCardViewStyle">@style/Widget.ATECGestao.CardView</item>
    </style>

    <!-- Botão com cantos mais arredondados -->
    <style name="Widget.ATECGestao.Button" parent="Widget.Material3.Button">
        <item name="cornerRadius">14dp</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:letterSpacing">0.02</item>
    </style>

    <!-- Cards com elevação suave -->
    <style name="Widget.ATECGestao.CardView" parent="Widget.Material3.CardView.Elevated">
        <item name="cardCornerRadius">16dp</item>
        <item name="cardElevation">2dp</item>
    </style>
</resources>
